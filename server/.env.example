# Copy to .env and edit. Players add the server in-game as <your-server-ip>:<E33_PUBLIC_PORT> with this key.
E33_KEY=change-me
E33_PUBLIC_PORT=33033
E33_MOTD=E33 Versus relay
# Log page: http://<your-server-ip>:<E33_LOG_PORT>/  (browser login: any user name, password = E33_ADMIN_KEY).
# Leave E33_ADMIN_KEY empty to keep the page off (logs are still written to the e33logs volume).
E33_ADMIN_KEY=
E33_LOG_PORT=33034
# days to keep room logs and uploaded game logs
E33_LOG_DAYS=30
# image tag to run: latest, or a release like v0.1.0
E33_TAG=latest
